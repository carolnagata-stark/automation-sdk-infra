# Copy to .env and fill in. .env is git-ignored and never committed.
# Loaded into every container by docker-compose.yml.
#
# Sandbox credentials read by the SDK test suites. The private keys carry the PEM text
# itself, not a path — keep the newlines, quote the whole value:
#
#   SANDBOX_INFRA_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----
#   ...
#   -----END EC PRIVATE KEY-----"
#
# The SDKs read these under different names; docker-compose.yml maps SANDBOX_INFRA_* to each
# one (see "Credentials" in README.md).

SANDBOX_INFRA_ID=
SANDBOX_INFRA_PRIVATE_KEY=
SANDBOX_ORGANIZATION_ID=
SANDBOX_ORGANIZATION_PRIVATE_KEY=
SANDBOX_BANK_CODE=
SANDBOX_TEMPLATE_ID=
SANDBOX_SIGNED_CREDIT_NOTE_ID=
